# ============================================================
# Aegis PMS — .gitignore consolidado
# Cobre: backend (Java/Spring Boot/Maven/Gradle), frontend
# (Node/React/Vite), Docker, Keycloak, banco de dados, OS e IDEs.
#
# IMPORTANTE: este arquivo só ignora artefatos locais/gerados.
# Ele NUNCA deve ser usado para remover do versionamento as
# configurações de Docker Compose, schemas, migrations ou specs
# de Keycloak/PostgreSQL — bancos dedicados e persistentes são
# decisão arquitetural (ADR-0005, ADR-0010, implementation/001
# Features 004/005) e suas CONFIGS continuam versionadas; apenas
# os DADOS/volumes/exports locais ficam fora do git.
# ============================================================

# ---------- OS ----------
.DS_Store
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Editores / IDEs ----------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ---------- Ambiente / segredos ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
!**/keycloak/realm-export*.json
secrets/
*.secret

# ---------- Backend: Java / Spring Boot / Maven / Gradle ----------
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties
*.class
*.jar
!**/wrapper/maven-wrapper.jar
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/
HELP.md
*.iws
*.ipr

# ---------- Frontend: Node / React / Vite ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/
.turbo/
.eslintcache

# build:backend (Sprint 20) copia o build do Vite para cá — artefato gerado, nunca commitado
backend/src/main/resources/static/
*.tsbuildinfo
vendor/

# ---------- Build outputs genéricos ----------
coverage/
*.tgz

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---------- Docker ----------
docker-compose.override.yml
.docker/
*.pid

# ---------- Banco de dados (Aegis + Keycloak) ----------
# Volumes/dumps locais nunca versionam — bancos são persistentes
# via volume Docker nomeado, não via arquivo no repositório.
*.sql.gz
*.dump
pgdata/
postgres-data/
keycloak-data/
*.mv.db

# ---------- Backend: storage local de assets (etapa 12, AEGIS_STORAGE_LOCAL_PATH) ----------
# Pasta criada automaticamente em runtime (LocalStorageBootstrap/LocalStorageProvider) —
# arquivos de asset enviados localmente nunca versionam.
backend/data/

# ---------- Keycloak (artefatos locais; exports versionados ficam fora deste padrão) ----------
keycloak/themes/*/cache/
keycloak/providers/*.jar

# ---------- Temporários ----------
*.tmp
*.temp
.cache/
