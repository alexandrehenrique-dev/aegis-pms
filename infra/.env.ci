# =============================================================================
# .env.ci — variáveis da stack EFÊMERA de CI (infra/docker-compose.ci.yml)
# =============================================================================
# Este arquivo É COMMITADO de propósito: todas as credenciais aqui são
# descartáveis, existem apenas durante o job de CI e morrem no `down -v`.
# JAMAIS colocar segredos reais aqui. JAMAIS usar este arquivo em produção.
#
# Uso (exatamente como o workflow faz):
#   docker compose -f infra/docker-compose.ci.yml --env-file infra/.env.ci up -d --build
#   docker compose -f infra/docker-compose.ci.yml --env-file infra/.env.ci down -v --remove-orphans
# =============================================================================

# Projeto compose separado — nunca colide com a stack de dev (aegis-pms)
COMPOSE_PROJECT_NAME=aegis-pms-ci

# Aegis PostgreSQL (efêmero — dados em tmpfs, nada persiste)
AEGIS_DB_NAME=aegis_pms_ci
AEGIS_DB_USER=aegis_ci_user
AEGIS_DB_PASSWORD=aegis_ci_password

# Keycloak PostgreSQL (efêmero)
KEYCLOAK_DB_NAME=keycloak_aegis_ci
KEYCLOAK_DB_USER=keycloak_ci_user
KEYCLOAK_DB_PASSWORD=keycloak_ci_password

# Keycloak (admin descartável — o container morre no fim do job)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=8282
KEYCLOAK_REALM=aegis
KEYCLOAK_WEB_CLIENT_ID=aegis-web

# Usuário de teste criado pelo bootstrap (mesmos defaults de bruno/collection.bru).
# O realm de import não tem passwordPolicy (a policy forte é reaplicada em prod
# pelo harden-realm-prod.sh), então a senha simples de CI é aceita. O workflow
# ainda injeta estas credenciais no Bruno via --env-var para manter a fonte única.
CI_TEST_USERNAME=aegis
CI_TEST_PASSWORD=aegis
CI_TEST_EMAIL=aegis-ci@example.com
CI_TEST_REALM_ROLE=AEGIS_SUPER_ADMIN

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
KEYCLOAK_ISSUER_URI=http://localhost:8282/realms/aegis

# SMTP — MailHog efêmero (capture-all)
SMTP_FROM=noreply@aegis.app
SMTP_FROM_DISPLAY_NAME=Aegis PMS
MAILHOG_UI_PORT=8025

# Limites de upload (mesmos de dev para não alterar comportamento dos testes)
AEGIS_ASSETS_MULTIPART_MAX_FILE_SIZE=260MB
AEGIS_ASSETS_MULTIPART_MAX_REQUEST_SIZE=260MB

# Timezone
TZ=America/Sao_Paulo
