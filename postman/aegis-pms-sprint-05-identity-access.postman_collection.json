{
  "info": {
    "name": "Aegis PMS — Sprint 05 — Identity and Access",
    "description": "Collection da Sprint 05 do Aegis PMS. Contexto: Resource Server com Keycloak e endpoint autenticado GET /api/v1/me. O grant_type=password é usado apenas para validação manual backend desta sprint, não representa o fluxo oficial da SPA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "backendBaseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "keycloakBaseUrl", "value": "http://localhost:8282", "type": "string" },
    { "key": "realm", "value": "aegis", "type": "string" },
    { "key": "clientId", "value": "aegis-web", "type": "string" },
    { "key": "username", "value": "loki", "type": "string" },
    { "key": "password", "value": "123456", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth — Keycloak",
      "description": "Autenticação manual para validação backend da Sprint 05.",
      "item": [
        {
          "name": "Get Token — Password Grant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "{{username}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakBaseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloakBaseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('access_token exists', function () { pm.expect(json.access_token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health — Public",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backendBaseUrl}}/actuator/health",
              "host": ["{{backendBaseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('body has status UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Info — Public",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backendBaseUrl}}/actuator/info",
              "host": ["{{backendBaseUrl}}"],
              "path": ["actuator", "info"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', function () { pm.response.to.have.status(200); });"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sprint 05 — Identity and Access",
      "description": "Validação do backend como OAuth2 Resource Server e endpoint /api/v1/me.",
      "item": [
        {
          "name": "Me — Without Token — 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backendBaseUrl}}/api/v1/me",
              "host": ["{{backendBaseUrl}}"],
              "path": ["api", "v1", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 401', function () { pm.response.to.have.status(401); });"]
              }
            }
          ]
        },
        {
          "name": "Me — Invalid Token — 401",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid-token" }
            ],
            "url": {
              "raw": "{{backendBaseUrl}}/api/v1/me",
              "host": ["{{backendBaseUrl}}"],
              "path": ["api", "v1", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 401', function () { pm.response.to.have.status(401); });"]
              }
            }
          ]
        },
        {
          "name": "Me — Bearer Token — 200",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{backendBaseUrl}}/api/v1/me",
              "host": ["{{backendBaseUrl}}"],
              "path": ["api", "v1", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('subject exists', function () { pm.expect(json.subject).to.be.a('string').and.not.empty; });",
                  "pm.test('email exists', function () { pm.expect(json.email).to.be.a('string').and.not.empty; });",
                  "pm.test('username exists', function () { pm.expect(json.username).to.be.a('string').and.not.empty; });",
                  "pm.test('name exists', function () { pm.expect(json.name).to.be.a('string').and.not.empty; });",
                  "pm.test('role is singular lowercase string', function () { pm.expect(json.role).to.be.oneOf(['super_admin', 'tenant_admin', 'product_manager', 'editor', 'viewer']); });",
                  "pm.test('role is not an array', function () { pm.expect(Array.isArray(json.role)).to.eql(false); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
