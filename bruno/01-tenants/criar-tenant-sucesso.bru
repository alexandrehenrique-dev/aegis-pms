meta {
  name: Criar tenant - sucesso
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tenants
  body: json
}

body:json {
  {
    "key": "{{tenantKey}}",
    "name": "{{tenantName}}",
    "plan": "FREE",
    "initialAdminEmail": "{{inviteEmail}}"
  }
}

docs {
Objetivo: criar um tenant novo (fluxo feliz).
Resultado esperado: 201, id presente, key preservada.
Variaveis usadas: tenantKey, tenantName, inviteEmail.
Variaveis produzidas: tenantId.
}

script:post-response {
bru.setVar('tenantId', res.body.id);
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("tenant id presente", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("tenant key preservada", function() {
    expect(res.body.key).to.equal(bru.getVar('tenantKey'));
  });
}
