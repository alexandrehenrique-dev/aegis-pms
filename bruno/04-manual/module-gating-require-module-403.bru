meta {
  name: Module gating @RequireModule - validar em controller futuro anotado
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/products/{{moduleSandboxProductId}}/assets
  body: none
}

docs {
Objetivo (historico, mantido por fidelidade): demonstrar que @RequireModule bloqueia o endpoint quando o modulo do path esta desabilitado. Usa o produto CUSTOM sandbox, que nao habilita ASSETS automaticamente — leitura, sem efeito colateral.
Resultado esperado: 403 MODULE_DISABLED.
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("erro MODULE_DISABLED", function() {
    expect(res.body.error).to.equal("MODULE_DISABLED");
    expect(res.body.moduleKey).to.equal("ASSETS");
  });
}
