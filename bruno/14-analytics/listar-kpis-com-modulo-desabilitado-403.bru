meta {
  name: Listar KPIs com modulo desabilitado - 403
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/analytics/kpis
  body: none
}

docs {
Objetivo: confirmar module-gating com @RequireModule(ModuleKey.ANALYTICS).
Resultado esperado: 403 MODULE_DISABLED.
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("erro MODULE_DISABLED", function() {
    expect(res.body.error).to.equal("MODULE_DISABLED");
    expect(res.body.moduleKey).to.equal("ANALYTICS");
  });
}
