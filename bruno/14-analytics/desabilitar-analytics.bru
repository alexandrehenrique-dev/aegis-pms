meta {
  name: Desabilitar ANALYTICS
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/modules/ANALYTICS/disable
  body: none
}

docs {
Objetivo: preparar o cenario de module-gating da Sprint 14.
Resultado esperado: 200, enabled false.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("ANALYTICS desabilitado", function() {
    expect(res.body.moduleKey).to.equal("ANALYTICS");
    expect(res.body.enabled).to.equal(false);
  });
}
