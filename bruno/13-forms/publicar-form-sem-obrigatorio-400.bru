meta {
  name: Publicar form sem obrigatorio - 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/forms/{{invalidFormId}}/publish
  body: none
}

docs {
Objetivo: confirmar que publicacao sem campo obrigatorio e rejeitada.
Resultado esperado: 400 FORM_REQUIRES_REQUIRED_FIELD.
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("erro de publicacao", function() {
    expect(res.body.error).to.equal("FORM_REQUIRES_REQUIRED_FIELD");
  });
}
