meta {
  name: Habilitar FORMS no produto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/modules/FORMS/enable
  body: none
}

docs {
Objetivo: habilitar o modulo FORMS para validar os endpoints da Sprint 13 na execucao sequencial da collection.
Resultado esperado: 200, enabled true.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("FORMS habilitado", function() {
    expect(res.body.moduleKey).to.equal("FORMS");
    expect(res.body.enabled).to.equal(true);
  });
}
