meta {
  name: Listar submissions do form
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/forms/{{formId}}/submissions
  body: none
}

docs {
Objetivo: listar submissions de um formulario publicado.
Resultado esperado: 200, lista vazia em ambiente sem endpoint publico de envio de submission.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("lista retornada", function() {
    expect(res.body).to.be.an('array');
  });
}
