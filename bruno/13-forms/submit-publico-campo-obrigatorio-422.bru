meta {
  name: Submit publico - campo obrigatorio 422
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/forms/{{formId}}/submit
  body: json
  auth: none
}

body:json {
  {
    "name": "Ana Publica",
    "email": "ana.publica@example.com",
    "source": "site",
    "answers": {}
  }
}

docs {
Objetivo: validar a regra da Sprint 19 que rejeita submit publico sem resposta de campo obrigatorio.
Resultado esperado: 422 MISSING_REQUIRED_FIELD.
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });
  test("erro de campo obrigatorio", function() {
    expect(res.body.error).to.equal("MISSING_REQUIRED_FIELD");
  });
}
