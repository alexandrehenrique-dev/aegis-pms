headers {
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getVar('username')) { bru.setVar('username', 'loki'); }
  if (!bru.getVar('password')) { bru.setVar('password', '123456'); }
  if (!bru.getVar('tenantKey')) { bru.setVar('tenantKey', 'byop-' + Date.now()); }
  if (!bru.getVar('productKey')) { bru.setVar('productKey', 'maestro-beton-' + Date.now()); }
  if (!bru.getVar('userId')) { bru.setVar('userId', ''); }
  if (!bru.getVar('inviteEmail')) { bru.setVar('inviteEmail', 'guest-' + Date.now() + '@example.com'); }
  if (!bru.getVar('tenantUserInviteEmail')) { bru.setVar('tenantUserInviteEmail', 'tenant-user-' + Date.now() + '@example.com'); }
  if (!bru.getVar('notificationInviteEmail')) { bru.setVar('notificationInviteEmail', 'notification-user-' + Date.now() + '@example.com'); }
  if (!bru.getVar('tenantName')) { bru.setVar('tenantName', 'BYOP'); }
  if (!bru.getVar('assetTagName')) { bru.setVar('assetTagName', 'institucional-' + Date.now()); }
  if (!bru.getVar('graphRefSeed')) { bru.setVar('graphRefSeed', String(Date.now())); }
  if (!bru.getVar('auditTenantKey')) { bru.setVar('auditTenantKey', 'audit-throwaway-' + Date.now()); }
}
