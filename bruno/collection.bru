headers {
  Authorization: Bearer {{token}}
}

script:pre-request {
  // Prefixo obrigatorio no "name" de qualquer tenant criado por uma collection
  // Bruno — e o unico criterio que a collection 99-teardown usa para decidir o
  // que pode excluir. Nunca prefixar CLIENTES BETA (nem qualquer tenant real)
  // com isso.
  if (!bru.getVar('testTenantPrefix')) { bru.setVar('testTenantPrefix', 'TEST-'); }
  if (!bru.getVar('username')) { bru.setVar('username', 'loki'); }
  if (!bru.getVar('password')) { bru.setVar('password', '123456'); }
  if (!bru.getVar('tenantKey')) { bru.setVar('tenantKey', 'byop-' + Date.now()); }
  if (!bru.getVar('productKey')) { bru.setVar('productKey', 'maestro-beton-' + Date.now()); }
  if (!bru.getVar('userId')) { bru.setVar('userId', ''); }
  if (!bru.getVar('inviteEmail')) { bru.setVar('inviteEmail', 'guest-' + Date.now() + '@example.com'); }
  if (!bru.getVar('tenantUserInviteEmail')) { bru.setVar('tenantUserInviteEmail', 'tenant-user-' + Date.now() + '@example.com'); }
  if (!bru.getVar('notificationInviteEmail')) { bru.setVar('notificationInviteEmail', 'notification-user-' + Date.now() + '@example.com'); }
  if (!bru.getVar('authActionAdminEmail')) { bru.setVar('authActionAdminEmail', 'auth-action-admin-' + Date.now() + '@example.com'); }
  if (!bru.getVar('authActionInviteEmail')) { bru.setVar('authActionInviteEmail', 'auth-action-' + Date.now() + '@example.com'); }
  if (!bru.getVar('authActionTenantKey')) { bru.setVar('authActionTenantKey', 'auth-action-' + Date.now()); }
  if (!bru.getVar('mailhogBaseUrl')) { bru.setVar('mailhogBaseUrl', 'http://localhost:8025'); }
  if (!bru.getVar('inviteActivationToken')) { bru.setVar('inviteActivationToken', ''); }
  if (!bru.getVar('passwordResetToken')) { bru.setVar('passwordResetToken', ''); }
  if (!bru.getVar('inviteActivationPassword')) { bru.setVar('inviteActivationPassword', 'Senha123'); }
  if (!bru.getVar('newPassword')) { bru.setVar('newPassword', 'NovaSenha456'); }
  if (!bru.getVar('resetPasswordEmail')) { bru.setVar('resetPasswordEmail', bru.getVar('username') + '@byop.io'); }
  if (!bru.getVar('tenantName')) { bru.setVar('tenantName', 'TEST-BYOP'); }
  if (!bru.getVar('assetTagName')) { bru.setVar('assetTagName', 'institucional-' + Date.now()); }
  if (!bru.getVar('graphRefSeed')) { bru.setVar('graphRefSeed', String(Date.now())); }
  if (!bru.getVar('auditTenantKey')) { bru.setVar('auditTenantKey', 'audit-throwaway-' + Date.now()); }
}
