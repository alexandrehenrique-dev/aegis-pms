headers {
  Authorization: Bearer {{token}}
}

script:pre-request {
  // Prefixo obrigatorio no "name" de qualquer tenant criado por uma collection
  // Bruno. A collection 99-teardown usa esse marcador, junto com padroes
  // legados fechados, para decidir o que pode excluir. Nunca prefixar CLIENTES
  // BETA (nem qualquer tenant real) com isso.
  if (!bru.getVar('testTenantPrefix')) { bru.setVar('testTenantPrefix', 'TEST-'); }
  if (!bru.getVar('protectedTenantIds')) { bru.setVar('protectedTenantIds', ''); }
  if (!bru.getVar('protectedTenantKeys')) { bru.setVar('protectedTenantKeys', ''); }
  if (!bru.getVar('protectedTenantNames')) { bru.setVar('protectedTenantNames', ''); }

  // G.1.3 (BUG-SPRINT-05) — bloqueia a criacao de tenant sem o prefixo TEST-
  // em qualquer ambiente, mesmo que alguem rode a collection com --env prod
  // por engano: sem essa guarda, um tenantName customizado sem o prefixo
  // nunca seria elegivel para o teardown automatico e viraria um tenant
  // fantasma permanente.
  {
    const prefix = bru.getVar('testTenantPrefix') || 'TEST-';
    const tName = bru.getVar('tenantName') || '';
    if (tName && !tName.startsWith(prefix)) {
      throw new Error(`[GUARD] tenantName "${tName}" nao tem o prefixo "${prefix}". Corrija antes de rodar.`);
    }
  }

  {
    const envUsername = bru.getEnvVar('username');
    const envPassword = bru.getEnvVar('password');
    if (envUsername) { bru.setVar('username', envUsername); }
    if (envPassword) { bru.setVar('password', envPassword); }
  }

  if (!bru.getVar('username')) { bru.setVar('username', 'aegis'); }
  if (!bru.getVar('password')) { bru.setVar('password', 'Cr&&d051207'); }
  if (!bru.getVar('tenantKey')) { bru.setVar('tenantKey', 'byop-' + Date.now()); }
  if (!bru.getVar('productKey')) { bru.setVar('productKey', 'maestro-beton-' + Date.now()); }
  if (!bru.getVar('userId')) { bru.setVar('userId', ''); }
  if (!bru.getVar('inviteEmail')) { bru.setVar('inviteEmail', 'guest-' + Date.now() + '@example.com'); }
  if (!bru.getVar('tenantUserInviteEmail')) { bru.setVar('tenantUserInviteEmail', 'tenant-user-' + Date.now() + '@example.com'); }
  if (!bru.getVar('brunoRbacPmEmail')) { bru.setVar('brunoRbacPmEmail', 'bruno-rbac-pm-' + Date.now() + '@example.com'); }
  if (!bru.getVar('brunoRbacEditorEmail')) { bru.setVar('brunoRbacEditorEmail', 'bruno-rbac-editor-' + Date.now() + '@example.com'); }
  if (!bru.getVar('brunoRbacViewerEmail')) { bru.setVar('brunoRbacViewerEmail', 'bruno-rbac-viewer-' + Date.now() + '@example.com'); }
  if (!bru.getVar('brunoRbacProductInviteEmail')) { bru.setVar('brunoRbacProductInviteEmail', 'bruno-rbac-product-' + Date.now() + '@example.com'); }
  if (!bru.getVar('brunoRbacTenantInviteEmail')) { bru.setVar('brunoRbacTenantInviteEmail', 'bruno-rbac-tenant-' + Date.now() + '@example.com'); }
  if (!bru.getVar('brunoRbacDeniedInviteEmail')) { bru.setVar('brunoRbacDeniedInviteEmail', 'bruno-rbac-denied-' + Date.now() + '@example.com'); }
  if (!bru.getVar('notificationInviteEmail')) { bru.setVar('notificationInviteEmail', 'notification-user-' + Date.now() + '@example.com'); }
  if (!bru.getVar('authActionAdminEmail')) { bru.setVar('authActionAdminEmail', 'auth-action-admin-' + Date.now() + '@example.com'); }
  if (!bru.getVar('authActionInviteEmail')) { bru.setVar('authActionInviteEmail', 'auth-action-' + Date.now() + '@example.com'); }
  if (!bru.getVar('authActionTenantKey')) { bru.setVar('authActionTenantKey', 'auth-action-' + Date.now()); }
  if (!bru.getVar('keycloakAdminUsername')) { bru.setVar('keycloakAdminUsername', 'admin'); }
  if (!bru.getVar('keycloakAdminPassword')) { bru.setVar('keycloakAdminPassword', 'admin'); }
  if (!bru.getVar('mailhogBaseUrl')) { bru.setVar('mailhogBaseUrl', 'http://localhost:8025'); }
  if (!bru.getVar('inviteActivationToken')) { bru.setVar('inviteActivationToken', ''); }
  if (!bru.getVar('passwordResetToken')) { bru.setVar('passwordResetToken', ''); }
  if (!bru.getVar('inviteActivationPassword')) { bru.setVar('inviteActivationPassword', 'SenhaForte123'); }
  if (!bru.getVar('newPassword')) { bru.setVar('newPassword', 'NovaSenha456'); }
  if (!bru.getVar('resetPasswordEmail')) { bru.setVar('resetPasswordEmail', bru.getVar('username') + '@byop.io'); }
  if (!bru.getVar('tenantName')) { bru.setVar('tenantName', 'TEST-BYOP'); }
  if (!bru.getVar('assetTagName')) { bru.setVar('assetTagName', 'institucional-' + Date.now()); }
  if (!bru.getVar('graphRefSeed')) { bru.setVar('graphRefSeed', String(Date.now())); }
  if (!bru.getVar('auditTenantKey')) { bru.setVar('auditTenantKey', 'audit-throwaway-' + Date.now()); }
}
