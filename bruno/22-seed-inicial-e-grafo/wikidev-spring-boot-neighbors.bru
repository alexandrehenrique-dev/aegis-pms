meta {
  name: WikiDev Spring Boot neighbors
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/products/{{seedWikiDevProductId}}/graph/nodes/{{seedSpringBootNodeId}}/neighbors
  body: none
}

docs {
Objetivo: validar neighbors do node Spring Boot criado pelo seed WikiDev.
Resultado esperado: 200 contendo Artigo JPA.
}

tests {
  test("status 200 ou acesso negado/sem node", function() {
    expect([200, 400, 403]).to.include(res.status);
  });
  test("Spring Boot aponta para JPA quando autorizado", function() {
    if (res.status !== 200) { return; }
    var item = res.body.find(function (neighbor) { return neighbor.node.refId === 'jpa'; });
    expect(item).to.exist;
    expect(item.edge.edgeType).to.equal('RELATED_TO');
  });
}
