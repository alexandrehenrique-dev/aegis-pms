meta {
  name: Buscar node JPA
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/products/{{seedWikiDevProductId}}/graph/nodes?q=JPA
  body: none
}

docs {
Objetivo: localizar o node Artigo JPA criado pelo seed WikiDev.
Resultado esperado: 200 com node Artigo JPA.
}

script:post-response {
  if (Array.isArray(res.body)) {
    var node = res.body.find(function (item) { return item.refId === 'jpa'; });
    if (node) { bru.setVar('seedJpaNodeId', node.id); }
  }
}

tests {
  test("status 200 ou 403", function() {
    expect([200, 403]).to.include(res.status);
  });
  test("node JPA existe quando autorizado", function() {
    if (res.status === 403) { return; }
    var node = res.body.find(function (item) { return item.refId === 'jpa'; });
    expect(node).to.exist;
    expect(node.label).to.equal('Artigo JPA');
  });
}
