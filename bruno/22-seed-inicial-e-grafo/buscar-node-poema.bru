meta {
  name: Buscar node Poema
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/products/{{seedLokiProductId}}/graph/nodes?q=Poema
  body: none
}

docs {
Objetivo: localizar o poema criado pelo seed Loki.
Resultado esperado: 200 com node Poema do Limiar.
}

script:post-response {
  if (Array.isArray(res.body)) {
    var node = res.body.find(function (item) { return item.refId === 'poema-do-limiar'; });
    if (node) { bru.setVar('seedPoemaNodeId', node.id); }
  }
}

tests {
  test("status 200 ou 403", function() {
    expect([200, 403]).to.include(res.status);
  });
  test("node poema existe quando autorizado", function() {
    if (res.status === 403) { return; }
    var node = res.body.find(function (item) { return item.refId === 'poema-do-limiar'; });
    expect(node).to.exist;
    expect(node.label).to.equal('Poema do Limiar');
  });
}
