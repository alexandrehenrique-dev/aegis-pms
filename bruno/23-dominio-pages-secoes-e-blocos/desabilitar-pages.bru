meta {
  name: Desabilitar PAGES
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/modules/PAGES/disable
  body: none
}

docs {
Objetivo: preparar o cenario de module-gating da Sprint 23.
Resultado esperado: 200, enabled false.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("PAGES desabilitado", function() {
    expect(res.body.enabled).to.equal(false);
  });
}
