meta {
  name: Habilitar PAGES no produto
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/modules/PAGES/enable
  body: none
}

docs {
Objetivo: habilitar o modulo PAGES para validar os endpoints da Sprint 23 na execucao sequencial da collection.
Resultado esperado: 200, enabled true.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("PAGES habilitado", function() {
    expect(res.body.moduleKey).to.equal("PAGES");
    expect(res.body.enabled).to.equal(true);
  });
}
