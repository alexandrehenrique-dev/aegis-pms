meta {
  name: Criar pagina da collection
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/pages
  body: json
}

body:json {
  {
    "slug": "bruno-page-{{graphRefSeed}}",
    "title": "Pagina Bruno",
    "locale": "pt-BR"
  }
}

docs {
Objetivo: criar uma pagina propria da collection sem disputar o scaffold "home" gerado automaticamente para produtos Site Institucional.
Resultado esperado: 201, slug unico, status "draft", version 1.
Variaveis produzidas: pageId.
}

script:post-response {
  bru.setVar('brunoPageSlug', res.body.slug);
  bru.setVar('pageId', res.body.id);
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("pagina criada em draft", function() {
    expect(res.body.id).to.be.a('string');
    expect(res.body.slug).to.equal("bruno-page-" + bru.getVar('graphRefSeed'));
    expect(res.body.status).to.equal("draft");
    expect(res.body.version).to.equal(1);
  });
}
