meta {
  name: Listar eventos com modulo desabilitado - 403
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/events
  body: none
}

docs {
Objetivo: confirmar que EventController usa o mesmo @RequireModule(ModuleKey.PAGES) do PageController — nenhum modulo novo criado para o dominio Event.
Resultado esperado: 403 MODULE_DISABLED.
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("erro MODULE_DISABLED", function() {
    expect(res.body.error).to.equal("MODULE_DISABLED");
    expect(res.body.moduleKey).to.equal("PAGES");
  });
}
