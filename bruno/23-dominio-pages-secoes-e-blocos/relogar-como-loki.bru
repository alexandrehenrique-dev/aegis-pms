meta {
  name: Relogar como loki (super_admin com assignment em productId)
  type: http
  seq: 1
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{username}}
  password: {{password}}
}

docs {
Objetivo: a pasta 22-seed-inicial-e-grafo termina autenticada como o usuario demo super-admin@byop.io (login-super-admin-seed), que nao tem ProductAssignment no {{productId}} criado em 02-products (produto avulso desta execucao, nao um dos produtos seedados). Reautentica como {{username}} (loki, o SUPER_ADMIN com assignment real em {{productId}}) antes de qualquer request desta pasta.
Resultado esperado: 200, access_token presente.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("access_token presente", function() {
    expect(res.body.access_token).to.be.a('string');
  });
}
