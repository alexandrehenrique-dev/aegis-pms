meta {
  name: Upload PDF - sucesso
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/assets
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(fixtures/curriculo.pdf) @contentType(application/pdf)
}

script:post-response {
  bru.setVar('pdfAssetId', res.body.id);
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("asset id presente", function() {
    expect(res.body.id).to.be.a('string');
  });
}

docs {
  Objetivo: upload de PDF dentro do limite de 15MB da categoria pdf.
  Resultado esperado: 201.
  Variaveis produzidas: pdfAssetId.
}
