meta {
  name: Editor cria 403
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/notifications
  body: json
}

body:json {
  {
    "type": "GENERAL",
    "title": "x",
    "bodyMarkdown": "x",
    "presentationMode": "BELL_ONLY",
    "target": { "type": "ALL" }
  }
}

docs {
Objetivo: validar que papel nao SUPER_ADMIN nao cria notificacao.
Resultado esperado: 403 NOTIFICATION_ADMIN_FORBIDDEN quando o editor demo existe, ou 401 quando o realm local nao trouxer esse usuario opcional.
}

tests {
  test("status 401 ou 403", function() {
    expect([401, 403]).to.include(res.status);
  });
  test("erro esperado", function() {
    if (res.status === 401) {
      return;
    }
    expect(res.body.error).to.equal('NOTIFICATION_ADMIN_FORBIDDEN');
  });
}
