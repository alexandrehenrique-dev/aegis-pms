meta {
  name: Login Editor
  type: http
  seq: 12
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: editor@byop.io
  password: senha123
}

docs {
Objetivo: autenticar como EDITOR para validar 403 nos endpoints administrativos.
Resultado esperado: 200 e token salvo em {{token}}.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
