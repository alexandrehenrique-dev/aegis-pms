meta {
  name: Login Editor
  type: http
  seq: 12
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: editor@byop.io
  password: senha123
}

docs {
Objetivo: autenticar como EDITOR demo para validar 403 nos endpoints administrativos quando o usuario existir no realm local.
Resultado esperado: 200 e token salvo em {{token}}, ou 401 quando o realm exportado local nao trouxer o usuario demo opcional.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200 ou demo ausente", function() {
    expect([200, 401]).to.include(res.status);
  });
}
