meta {
  name: Login Super Admin para convite
  type: http
  seq: 15
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: super-admin@byop.io
  password: senha123
}

docs {
Objetivo: restaurar token SUPER_ADMIN antes de convidar novo usuario para validar integracao com onboarding.
Resultado esperado: 200.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
