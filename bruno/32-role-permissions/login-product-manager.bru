meta {
  name: Login seed - product manager
  type: http
  seq: 8
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{brunoRbacPmEmail}}
  password: {{inviteActivationPassword}}
}

script:post-response {
  bru.setVar('rbacPmToken', res.body.access_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
