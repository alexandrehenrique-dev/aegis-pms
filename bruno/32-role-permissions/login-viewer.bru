meta {
  name: Login seed - viewer
  type: http
  seq: 10
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{brunoRbacViewerEmail}}
  password: {{inviteActivationPassword}}
}

script:post-response {
  bru.setVar('rbacViewerToken', res.body.access_token);
  const result = await new Promise((resolve) => {
    bru.sendRequest({
      method: 'GET',
      url: bru.getEnvVar('baseUrl') + '/api/v1/me',
      headers: { 'Authorization': 'Bearer ' + res.body.access_token },
    }, function(error, response) {
      resolve({ error, response });
    });
  });
  const rawBody = result.response && (result.response.body !== undefined ? result.response.body : result.response.data);
  const body = typeof rawBody === 'string' ? JSON.parse(rawBody) : rawBody;
  bru.setVar('rbacViewerRole', body && body.role ? body.role : '');
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("/me reconhece Viewer canonico", function() {
    expect(bru.getVar('rbacViewerRole')).to.equal('viewer');
  });
}
