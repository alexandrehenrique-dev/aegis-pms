meta {
  name: Bloquear usuario
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/users/{{tenantUserId}}/block
  body: none
}

docs {
Objetivo: bloquear acesso do usuario no tenant, sem remover Keycloak nem ProductAssignment de outros tenants.
Resultado esperado: 200, status bloqueado.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("usuario bloqueado", function() {
    expect(res.body.status).to.equal("bloqueado");
  });
}
