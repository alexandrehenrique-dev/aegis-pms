meta {
  name: Validar token inexistente - 404
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/invite/validate
  body: json
}

body:json {
  {
    "token": "00000000-0000-0000-0000-000000000029"
  }
}

docs {
Objetivo: confirmar contrato publico de erro para token inexistente.
Resultado esperado: 404 TOKEN_NOT_FOUND.
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("erro TOKEN_NOT_FOUND", function() {
    expect(res.body.error).to.equal("TOKEN_NOT_FOUND");
  });
}
