meta {
  name: Capturar token de reset no MailHog
  type: http
  seq: 9
}

get {
  url: {{mailhogBaseUrl}}/api/v2/messages?limit=50
  body: none
  auth: none
}

docs {
Objetivo: buscar no MailHog o e-mail enviado para resetPasswordEmail e extrair o UUID do parametro token da URL /reset-password.
Resultado esperado: 200 e variavel passwordResetToken preenchida.
Pre-requisito: executar antes "Solicitar reset de senha" e manter MailHog acessivel em mailhogBaseUrl.
}

script:post-response {
  const targetEmail = bru.getVar('resetPasswordEmail');
  const mailhogBaseUrl = bru.getEnvVar('mailhogBaseUrl');
  let payload = parseResponseBody(res.body);
  let items = payload.items || payload.Items || [];
  const tokenPattern = /\/reset-password\?token=([0-9a-fA-F-]{36})/;

  function parseResponseBody(value) {
    const raw = res.getDataBuffer();
    if (raw) {
      try {
        return JSON.parse(raw.toString('utf8'));
      } catch (error) {
        // Mantem compatibilidade com runtimes que ja entregam o JSON desserializado.
      }
    }
    if (typeof value === 'string') {
      try {
        return JSON.parse(value);
      } catch (error) {
        return {};
      }
    }
    return value && typeof value === 'object' ? value : {};
  }

  function decodeQuotedPrintable(value) {
    return value
      .replace(/=\r?\n/g, '')
      .replace(/=3D/g, '=');
  }

  function recipientMatches(message) {
    const to = message.To || message.to || [];
    const envelopeMatches = Array.isArray(to)
      && to.some((recipient) => {
        const mailbox = recipient.Mailbox || recipient.mailbox || '';
        const domain = recipient.Domain || recipient.domain || '';
        const address = domain ? mailbox + '@' + domain : mailbox;
        return address === targetEmail;
      });
    const headers = message.Content && message.Content.Headers
      ? message.Content.Headers.To || message.Content.Headers.to || []
      : [];
    const headerMatches = Array.isArray(headers)
      && headers.some((recipient) => String(recipient).includes(targetEmail));
    return envelopeMatches || headerMatches;
  }

  async function refreshMessages() {
    const response = await fetch(mailhogBaseUrl + '/api/v2/messages?limit=50');
    return response.ok ? response.json() : {};
  }

  let message = items.find((item) => recipientMatches(item));
  for (let attempt = 0; !message && attempt < 30; attempt += 1) {
    await new Promise((resolve) => setTimeout(resolve, 200));
    payload = await refreshMessages();
    items = payload.items || payload.Items || [];
    message = items.find((item) => recipientMatches(item));
  }
  const rawBody = message && message.Content ? String(message.Content.Body || '') : '';
  const body = decodeQuotedPrintable(rawBody);
  const match = body.match(tokenPattern);

  if (match) {
    bru.setVar('passwordResetToken', match[1]);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("passwordResetToken capturado", function() {
    expect(bru.getVar('passwordResetToken')).to.match(/^[0-9a-fA-F-]{36}$/);
  });
}
