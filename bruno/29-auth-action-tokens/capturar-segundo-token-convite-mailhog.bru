meta {
  name: Capturar segundo token de convite no MailHog
  type: http
  seq: 14
}

get {
  url: {{mailhogBaseUrl}}/api/v2/messages?limit=50
  body: none
  auth: none
}

docs {
Objetivo: buscar no MailHog o segundo e-mail de convite enviado para authActionInviteEmail
(gerado por "Convidar usuario existente no segundo tenant") e extrair o token da URL /invite.
O MailHog retorna as mensagens mais recentes primeiro, entao o primeiro item que casar com o
destinatario ja e o token do segundo convite, distinto do token da sequencia 1-7 (ja consumido).
Resultado esperado: 200 e variavel existingUserInviteToken preenchida.
Pre-requisito: executar antes "Convidar usuario existente no segundo tenant" (seq 13).
}

script:post-response {
  const targetEmail = bru.getVar('authActionInviteEmail');
  const items = res.body.items || res.body.Items || [];
  const tokenPattern = /\/invite\?token=([0-9a-fA-F-]{36})/;

  function decodeQuotedPrintable(value) {
    return value
      .replace(/=\r?\n/g, '')
      .replace(/=3D/g, '=');
  }

  function recipientMatches(message) {
    const to = message.To || message.to || [];
    if (Array.isArray(to)) {
      return to.some((recipient) => {
        const mailbox = recipient.Mailbox || recipient.mailbox || '';
        const domain = recipient.Domain || recipient.domain || '';
        const address = domain ? mailbox + '@' + domain : mailbox;
        return address === targetEmail;
      });
    }
    return false;
  }

  const message = items.find((item) => recipientMatches(item));
  const rawBody = message && message.Content ? String(message.Content.Body || '') : '';
  const body = decodeQuotedPrintable(rawBody);
  const match = body.match(tokenPattern);

  if (match) {
    bru.setVar('existingUserInviteToken', match[1]);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("existingUserInviteToken capturado", function() {
    expect(bru.getVar('existingUserInviteToken')).to.match(/^[0-9a-fA-F-]{36}$/);
  });
}
