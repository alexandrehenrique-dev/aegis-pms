meta {
  name: Login Super Admin
  type: http
  seq: 0
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: super-admin@byop.io
  password: senha123
}

docs {
Objetivo: autenticar como SUPER_ADMIN antes de validar o seed de homologacao.
Resultado esperado: 200 e token salvo em {{token}}.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
