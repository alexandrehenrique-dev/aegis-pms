meta {
  name: Login Super Admin
  type: http
  seq: 1
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{username}}
  password: {{password}}
}

docs {
Objetivo: autenticar com as credenciais do ambiente Bruno local para preparar tenant/produto/asset e listar feedback global.
Resultado esperado: 200 e token salvo em {{token}}.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
