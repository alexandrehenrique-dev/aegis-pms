meta {
  name: Bloquear tenant alheio como TENANT_ADMIN
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{feedbackTenantId}}/feedback
  body: none
}

docs {
Objetivo: validar isolamento — TENANT_ADMIN sem membership no tenant da pasta 27 nao lista seus feedbacks.
Resultado esperado: 404 FEEDBACK_NOT_FOUND quando o tenant admin demo existe, ou 401 quando o realm local nao trouxer esse usuario opcional.
}

tests {
  test("status 401 ou 404", function() {
    expect([401, 404]).to.include(res.status);
  });
  test("erro esperado", function() {
    if (res.status === 401) {
      return;
    }
    expect(res.body.error).to.equal("FEEDBACK_NOT_FOUND");
  });
}
