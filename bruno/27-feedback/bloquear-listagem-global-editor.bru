meta {
  name: Bloquear listagem global como editor
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/feedback
  body: none
}

docs {
Objetivo: validar que usuario comum nao acessa listagem global.
Resultado esperado: 403 FEEDBACK_FORBIDDEN quando o editor demo existe, ou 401 quando o realm local nao trouxer esse usuario opcional.
}

tests {
  test("status 401 ou 403", function() {
    expect([401, 403]).to.include(res.status);
  });
  test("erro esperado", function() {
    if (res.status === 401) {
      return;
    }
    expect(res.body.error).to.equal("FEEDBACK_FORBIDDEN");
  });
}
