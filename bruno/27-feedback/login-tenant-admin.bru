meta {
  name: Login Tenant Admin
  type: http
  seq: 21
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: admin@byop.io
  password: senha123
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

docs {
Objetivo: autenticar usuario demo TENANT_ADMIN do tenant Clientes Beta.
Resultado esperado: 200.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
