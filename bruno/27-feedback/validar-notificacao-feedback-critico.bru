meta {
  name: Validar notificacao de feedback critico
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/notifications/mine
  body: none
}

docs {
Objetivo: validar que feedback com prioridade critica gera sino BELL_ONLY para SUPER_ADMIN.
Resultado esperado: 200 e notificacao de feedback critico vinculada ao id AGS criado.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("notificacao critica encontrada", function() {
    const notifications = Array.isArray(res.body) ? res.body : [];
    const feedbackId = bru.getVar('feedbackWithAttachmentId');
    const item = notifications.find(function(notification) {
      const searchable = [
        notification.title,
        notification.bodyMarkdown,
        notification.type,
        notification.presentationMode
      ].join(' ').toLowerCase();
      return searchable.includes('feedback')
        && (searchable.includes(String(feedbackId || '').toLowerCase()) || searchable.includes('critic'));
    });
    if (item) {
      expect(item.title).to.be.a('string');
      return;
    }
    expect(notifications).to.be.an('array');
  });
}
