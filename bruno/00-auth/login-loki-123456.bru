meta {
  name: Login - loki / 123456
  type: http
  seq: 1
}

post {
  url: {{keycloakIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{username}}
  password: {{password}}
}

docs {
  Objetivo: autenticar contra o Keycloak (Resource Owner Password Credentials) e capturar token/refreshToken para o restante da collection.
  Resultado esperado: 200, access_token e refresh_token presentes.
  Variaveis utilizadas: keycloakIssuer, clientId, username, password (definidas no environment ativo e/ou no script:pre-request da collection).
  Variaveis produzidas: token, refreshToken.
}

script:post-response {
  bru.setVar('token', res.body.access_token);
  bru.setVar('refreshToken', res.body.refresh_token);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("access_token presente", function() {
    expect(res.body.access_token).to.be.a('string');
  });
  test("refresh_token presente", function() {
    expect(res.body.refresh_token).to.be.a('string');
  });
}
