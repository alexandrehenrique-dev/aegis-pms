meta {
  name: Listar conteudo com modulo desabilitado (403 MODULE_DISABLED)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/content
  body: none
}

docs {
Resultado esperado: 403 MODULE_DISABLED, mesmo para SUPER_ADMIN.
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("erro MODULE_DISABLED", function() {
    expect(res.body.error).to.equal("MODULE_DISABLED");
    expect(res.body.moduleKey).to.equal("CONTENT");
  });
}
