meta {
  name: Reabilitar KNOWLEDGE_GRAPH para as proximas pastas - sucesso
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/modules/KNOWLEDGE_GRAPH/enable
  body: none
}

docs {
Decisao de reconstrucao: a pasta 05 (Knowledge Graph) reaproveita {{productId}} e precisa do modulo KNOWLEDGE_GRAPH habilitado. O cenario de desabilitar (passo 5) ja foi validado; este passo deixa o estado limpo para as pastas seguintes.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("KNOWLEDGE_GRAPH habilitado novamente", function() {
    expect(res.body.enabled).to.equal(true);
  });
}
