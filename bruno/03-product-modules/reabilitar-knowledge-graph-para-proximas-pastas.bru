meta {
  name: Reabilitar KNOWLEDGE_GRAPH para as proximas pastas - sucesso
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/products/{{moduleSandboxProductId}}/modules/KNOWLEDGE_GRAPH/enable
  body: none
}

docs {
Decisao de reconstrucao: o sandbox de modulos volta a ter KNOWLEDGE_GRAPH habilitado depois dos cenarios negativos, sem alterar o produto principal.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("KNOWLEDGE_GRAPH habilitado novamente", function() {
    expect(res.body.enabled).to.equal(true);
  });
}
