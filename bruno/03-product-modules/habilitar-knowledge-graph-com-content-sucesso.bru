meta {
  name: Habilitar KNOWLEDGE_GRAPH com CONTENT e ASSETS - sucesso
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/products/{{moduleSandboxProductId}}/modules/KNOWLEDGE_GRAPH/enable
  body: none
}

docs {
Objetivo: com CONTENT e ASSETS habilitados, as dependencias do Knowledge Graph estao satisfeitas.
Resultado esperado: 200.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("KNOWLEDGE_GRAPH habilitado", function() {
    expect(res.body.moduleKey).to.equal("KNOWLEDGE_GRAPH");
    expect(res.body.enabled).to.equal(true);
  });
}
