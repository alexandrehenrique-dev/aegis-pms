meta {
  name: Habilitar KNOWLEDGE_GRAPH sem CONTENT - 400
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{moduleSandboxProductId}}/modules/KNOWLEDGE_GRAPH/enable
  body: none
}

docs {
Objetivo: KNOWLEDGE_GRAPH depende de CONTENT. Usa o produto CUSTOM sandbox, que nasce sem modulos recomendados.
Resultado esperado: 400 MODULE_DEPENDENCY_MISSING.
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("erro MODULE_DEPENDENCY_MISSING", function() {
    expect(res.body.error).to.equal("MODULE_DEPENDENCY_MISSING");
  });
}
