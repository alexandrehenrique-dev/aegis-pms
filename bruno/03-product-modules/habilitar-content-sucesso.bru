meta {
  name: Habilitar CONTENT - sucesso
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/products/{{moduleSandboxProductId}}/modules/CONTENT/enable
  body: none
}

docs {
Objetivo: habilitar o modulo CONTENT.
Resultado esperado: 200, enabled true.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("CONTENT habilitado", function() {
    expect(res.body.moduleKey).to.equal("CONTENT");
    expect(res.body.enabled).to.equal(true);
  });
}
