meta {
  name: Reabilitar CONTENT para as proximas pastas - sucesso
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/products/{{moduleSandboxProductId}}/modules/CONTENT/enable
  body: none
}

docs {
Decisao de reconstrucao: o sandbox de modulos volta a ter CONTENT habilitado depois dos cenarios negativos, sem alterar o produto principal.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("CONTENT habilitado novamente", function() {
    expect(res.body.enabled).to.equal(true);
  });
}
