meta {
  name: Criar produto com type desconhecido - 400
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
}

body:json {
  {
    "tenantId": "{{tenantId}}",
    "key": "tipo-invalido-{{productKey}}",
    "name": "Produto Invalido",
    "type": "Tipo Que Nao Existe",
    "defaultLocale": "pt-BR"
  }
}

docs {
Objetivo: type fora do catalogo fechado de ProductTypeKey deve ser rejeitado.
Resultado esperado: 400 INVALID_PRODUCT_TYPE.
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("erro INVALID_PRODUCT_TYPE", function() {
    expect(res.body.error).to.equal("INVALID_PRODUCT_TYPE");
  });
}
