meta {
  name: Criar TOPIC node
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/graph/nodes
  body: json
}

body:json {
  {
    "nodeType": "TOPIC",
    "refType": "TOPIC",
    "refId": "topic-{{graphRefSeed}}",
    "label": "Topico de Teste",
    "slug": "topico-teste-{{graphRefSeed}}"
  }
}

docs {
Objetivo: criar um node TOPIC para relacionar ao ARTICLE.
Resultado esperado: 201.
Variaveis produzidas: topicNodeId.
}

script:post-response {
bru.setVar('topicNodeId', res.body.id);
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("node id presente", function() {
    expect(res.body.id).to.be.a('string');
  });
}
