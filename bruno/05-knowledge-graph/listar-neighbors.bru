meta {
  name: Listar neighbors
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/graph/nodes/{{articleNodeId}}/neighbors
  body: none
}

docs {
Objetivo: vizinhos diretos (1 hop) do ARTICLE — deve incluir o TOPIC.
Resultado esperado: 200, array nao vazio.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("contem o topic vizinho", function() {
    expect(res.body).to.be.an('array').that.is.not.empty;
  });
}
