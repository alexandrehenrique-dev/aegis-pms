meta {
  name: Limpar tenants de teste
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/tenants
  body: none
}

docs {
Objetivo: identificar e excluir SOMENTE tenants marcados como teste, para nunca
apagar tenants reais (ex.: CLIENTES BETA) mesmo que existam dezenas deles no futuro.

Criterio de exclusao principal (ver collection.bru / testTenantPrefix): o nome
ou a key do tenant comeca com marcador de teste. Esse marcador e aplicado NA
CRIACAO por toda collection Bruno que cria um tenant (ver bruno/01-tenants,
16-audit, 26-product-templates, 27-feedback, 28-backup-exportacao-exclusao,
29-auth-action-tokens) — nunca na hora de excluir.

Compatibilidade para sujeira antiga: tambem sao candidatos padroes fechados
criados por suites antigas e Maven local ("Tenant listener-commit",
"Tenant listener-rollback", "Tenant <uuid>", "Tenant E2E <timestamp>",
"TEST-Maven ...", keys "tenant-<uuid>" e keys "test-tenant-listener-*").
Nomes reais sem marcador de teste nunca entram como candidatos.

CLIENTES BETA e protegido por id/key/name. Tenants reais criados manualmente
para usuarios externos devem ser preservados incluindo id, key ou name nas
variaveis protectedTenantIds, protectedTenantKeys ou protectedTenantNames
(lista separada por virgula, ponto-e-virgula ou quebra de linha) do environment.

DELETE /api/v1/tenants/{id} e ASSINCRONO — retorna 202 e apenas INICIA a exportacao
por produto (ProductExportCoordinatorService); o tenant so some de fato depois que
todos os produtos terminarem de exportar (fluxo real usa Keycloak Admin API, zip e
e-mail via MailHog). Por isso este step confirma que a exclusao foi aceita
(202) ou que o tenant ja estava em um fluxo equivalente de remocao/exportacao
(404/409) — nao espera nem afirma que eles ja sumiram.
A confirmacao "nenhum tenant real foi tocado" e feita pelo health-check final,
que so verifica a presenca de CLIENTES BETA (nao a ausencia imediata dos de teste).

Idempotente: se rodar de novo e nao houver mais tenants com marcador de teste,
o loop simplesmente nao encontra candidatos e nao faz nenhuma chamada DELETE.

IMPORTANTE: o post-response usa `bru.sendRequest()` para fazer uma chamada
DELETE por tenant candidato. Assim funciona no app do Bruno e no CLI, sem
depender de `fetch`.
}

script:post-response {
  const prefix = bru.getVar('testTenantPrefix') || 'TEST-';
  const tenants = Array.isArray(res.body) ? res.body : [];

  function normalize(value) {
    return String(value || '').trim();
  }

  function normalizeKey(value) {
    return normalize(value).toLowerCase();
  }

  function parseProtectedList(value) {
    return normalize(value)
      .split(/[\n,;]+/)
      .map((item) => item.trim().toLowerCase())
      .filter(Boolean);
  }

  const protectedIds = parseProtectedList(bru.getVar('protectedTenantIds'));
  const protectedKeys = parseProtectedList(bru.getVar('protectedTenantKeys'));
  const protectedNames = parseProtectedList(bru.getVar('protectedTenantNames'));

  function isProtectedTenant(tenant) {
    const id = normalizeKey(tenant.id);
    const name = normalizeKey(tenant.name);
    const key = normalizeKey(tenant.key);
    return id === 'a0000000-0000-0000-0000-000000000001'
      || name === 'clientes beta'
      || key === 'clientes-beta'
      || protectedIds.includes(id)
      || protectedKeys.includes(key)
      || protectedNames.includes(name);
  }

  function isLegacyTestTenantName(name) {
    return /^Tenant listener-(commit|rollback)$/i.test(name)
      || /^Tenant [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(name)
      || /^Tenant E2E [0-9]+$/i.test(name)
      || /^TEST-Maven /i.test(name)
      || /^TEST-Form Listener /i.test(name);
  }

  function isLegacyTestTenantKey(key) {
    return /^tenant-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(key)
      || /^tenant-submission-/i.test(key)
      || /^tenant-membership-/i.test(key)
      || /^tenant-notification-/i.test(key)
      || /^test-tenant-listener-(commit|rollback)-[0-9a-f-]{36}$/i.test(key)
      || /^feedback-(cross-)?tenant-[0-9]+$/i.test(key)
      || /^template-tenant-[0-9]+$/i.test(key)
      || /^export-delete-tenant-[0-9]+$/i.test(key)
      || /^auth-action-[0-9]+$/i.test(key)
      || /^audit-throwaway-[0-9]+$/i.test(key);
  }

  function isTestTenant(tenant) {
    const name = normalize(tenant.name);
    const key = normalize(tenant.key);
    const normalizedPrefix = normalizeKey(prefix);
    return name.startsWith(prefix)
      || normalizeKey(key).startsWith(normalizedPrefix.toLowerCase())
      || isLegacyTestTenantName(name)
      || isLegacyTestTenantKey(key);
  }

  function deleteTenant(tenant) {
    return new Promise((resolve) => {
      bru.sendRequest({
        method: 'DELETE',
        url: baseUrl + '/api/v1/tenants/' + tenant.id,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token,
        },
        data: {
          confirmationText: tenant.name,
        },
      }, function(error, response) {
        if (error) {
          resolve({
            ok: false,
            error: String(error),
          });
          return;
        }

        const rawStatus = response && (response.status || response.statusCode);
        const status = Number.parseInt(String(rawStatus || ''), 10);
        resolve({
          ok: [202, 404, 409].includes(status),
          status: Number.isNaN(status) ? rawStatus : status,
        });
      });
    });
  }

  function listTenantIds() {
    return new Promise((resolve) => {
      bru.sendRequest({
        method: 'GET',
        url: baseUrl + '/api/v1/tenants',
        headers: {
          'Authorization': 'Bearer ' + token,
        },
      }, function(error, response) {
        if (error) {
          resolve([]);
          return;
        }

        const payload = response && (response.data || response.body);
        if (Array.isArray(payload)) {
          resolve(payload.map((tenant) => tenant.id));
          return;
        }
        if (typeof payload === 'string') {
          try {
            const parsed = JSON.parse(payload);
            resolve(Array.isArray(parsed) ? parsed.map((tenant) => tenant.id) : []);
            return;
          } catch (parseError) {
            resolve([]);
            return;
          }
        }
        resolve([]);
      });
    });
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function tenantDisappeared(tenantId) {
    for (let attempt = 0; attempt < 6; attempt += 1) {
      const visibleTenantIds = await listTenantIds();
      if (!visibleTenantIds.includes(tenantId)) {
        return true;
      }
      await sleep(150);
    }
    return false;
  }

  const candidates = tenants.filter((tenant) => isTestTenant(tenant) && !isProtectedTenant(tenant));

  const baseUrl = bru.getEnvVar('baseUrl');
  const token = bru.getVar('token');
  let accepted = 0;
  const failures = [];

  for (const tenant of candidates) {
    const result = await deleteTenant(tenant);
    if (result.ok) {
      accepted += 1;
    } else {
      const goneAfterAsyncDelete = await tenantDisappeared(tenant.id);
      if (!goneAfterAsyncDelete) {
        failures.push({
          id: tenant.id,
          key: tenant.key,
          name: tenant.name,
          status: result.status,
          error: result.error,
        });
      } else {
        accepted += 1;
      }
    }
  }

  bru.setVar('teardownCandidateCount', candidates.length);
  bru.setVar('teardownAcceptedCount', accepted);
  bru.setVar('teardownCandidateNames', JSON.stringify(candidates.map((tenant) => tenant.name)));
  bru.setVar('teardownCandidateKeys', JSON.stringify(candidates.map((tenant) => tenant.key)));
  bru.setVar('teardownFailures', JSON.stringify(failures));
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("CLIENTES BETA nunca e candidata a exclusao", function() {
    const tenants = Array.isArray(res.body) ? res.body : [];
    const beta = tenants.find((t) => String(t.name || '').trim().toLowerCase() === 'clientes beta');
    if (beta) {
      expect(String(beta.name)).to.equal('CLIENTES BETA');
    }
  });
  test("tenants reais sem marcador de teste nao entram na limpeza", function() {
    const candidateNames = JSON.parse(bru.getVar('teardownCandidateNames') || '[]');
    const candidateKeys = JSON.parse(bru.getVar('teardownCandidateKeys') || '[]');
    expect(candidateNames).to.not.include('CLIENTES BETA');
    expect(candidateKeys).to.not.include('clientes-beta');
    expect(candidateNames).to.not.include('BYOP');
  });
  test("exclusao aceita ou ja em andamento para todos os candidatos de teste", function() {
    expect(bru.getVar('teardownFailures')).to.equal('[]');
  });
}
