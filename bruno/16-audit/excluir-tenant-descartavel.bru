meta {
  name: Excluir tenant descartavel
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/tenants/{{auditTenantId}}
  body: json
}

body:json {
  {
    "confirmationText": "TEST-Audit Throwaway Tenant"
  }
}

docs {
Objetivo: excluir o tenant criado na request anterior, gerando o evento
TENANT_DELETED que a request seguinte verifica.
Resultado esperado: 202, pois a exclusao de tenant inicia exportacao/exclusao assincrona.
}

tests {
  test("status 202", function() {
    expect(res.status).to.equal(202);
  });
}
