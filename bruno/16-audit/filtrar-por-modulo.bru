meta {
  name: Filtrar audit-events por modulo
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/audit-events?module=CONTENT
  body: none
  auth: none
}

vars:pre-request {
  tenantId: 9f8513ab-a1e4-48a9-a84d-2bcdf637fc11
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("todos os itens sao do modulo CONTENT", function() {
    expect(res.body.length).to.be.greaterThan(0);
    res.body.forEach(function(event) {
      expect(event.module).to.equal('CONTENT');
    });
  });
}

docs {
  Objetivo: filtro por module=CONTENT — CONTENT_CREATED/CONTENT_PUBLISHED
  (gerados em 11-content) garantem ao menos um resultado, mesmo que o modulo
  CONTENT do produto tenha sido desabilitado depois (auditoria nao e gateada
  por modulo, Secao 9.2 do padrao de qualidade).
  Resultado esperado: 200, todos os itens com module "CONTENT".
}
